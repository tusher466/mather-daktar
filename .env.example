# ==========================================
# মাঠের ডাক্তার (Mather Daktar) Environment Variables
# ==========================================

# AI Provider API Key (Required on server-side only)
# For Gemini API: your Google AI Studio API key
# For Claude API: your Anthropic API key
AI_API_KEY=your_api_key_here

# Optional: Specify provider ("gemini" or "anthropic"). Defaults to "gemini" if not set.
AI_PROVIDER=gemini

# Optional: Custom model string.
# Defaults: "gemini-2.5-flash" (or "gemini-1.5-flash") for Gemini, "claude-3-5-sonnet-20241022" for Anthropic.
AI_MODEL=gemini-2.5-flash
